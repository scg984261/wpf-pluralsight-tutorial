<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Base style which all text box styles will inherit from. -->
    <Style TargetType="TextBox" x:Key="TextBoxStyleBase">
        <Setter Property="Padding" Value="5" />
    </Style>
    
    <!-- Inherit this style from a base style. -->
    <!-- No x:Key attribute means that this style is an implicit style. -->
    <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxStyleBase}">
        <Setter Property="Background" Value="#555555" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <StackPanel>
                        <AdornedElementPlaceholder />
                        <TextBlock Foreground="Red" Text="This is not valid" Margin="3,0,0,0" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="5" />
        <Setter Property="BorderBrush" Value="#111111" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="Green" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="Background" Value="#111111" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="Background" Value="Red" />
                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                <Setter Property="Margin" Value="0,0,0,20" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
